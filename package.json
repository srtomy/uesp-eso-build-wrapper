{
  "name": "uesp-eso-build-wrapper",
  "version": "0.3.0",
  "description": "Node.js wrapper around the UESP ESO Build Editor math engine. Calculate Elder Scrolls Online character stats (Health, Magicka, Stamina, mitigation, crit, etc.) without rewriting any game formulas.",
  "keywords": [
    "elder-scrolls-online",
    "eso",
    "uesp",
    "build-editor",
    "character-stats",
    "eso-build",
    "game",
    "wrapper"
  ],
  "license": "MIT",
  "author": {
    "name": "Tarcisio Scotta",
    "email": "tarcisioscotta2@gmail.com",
    "url": "https://github.com/srtomy"
  },
  "homepage": "https://github.com/srtomy/uesp-eso-build-wrapper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srtomy/uesp-eso-build-wrapper.git"
  },
  "bugs": {
    "url": "https://github.com/srtomy/uesp-eso-build-wrapper/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/lib/eso-engine/index.js",
  "types": "dist/lib/eso-engine/index.d.ts",
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/lib/eso-engine/index.d.ts",
      "default": "./dist/lib/eso-engine/index.js"
    }
  },
  "files": [
    "dist",
    "vendor/uesp-esochardata/resources/esoEditBuild.js",
    "vendor/uesp-esochardata/resources/esobuilddata.js",
    "vendor/uesp-esochardata/LICENSE",
    "vendor/uesp-esolog/resources/esoskills.js",
    "vendor/uesp-esolog/LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "publint": "publint",
    "attw": "attw --pack . --ignore-rules cjs-resolves-to-esm",
    "generate-data": "tsx --experimental-sqlite --no-warnings scripts/generate-data.ts",
    "db:seed": "tsx --experimental-sqlite --no-warnings scripts/seed-db.ts",
    "prepublishOnly": "npm run build && npm run lint",
    "test": "vitest run",
    "test:esm": "node scripts/test-esm-import.mjs",
    "test:coverage": "vitest run --coverage",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:api": "typedoc --options typedoc.json && npm run docs:api:sync-pt",
    "docs:api:sync-pt": "rm -rf docs/pt/api && cp -r docs/api docs/pt/api",
    "test:explore": "tsx scripts/test-engine.ts",
    "test:build": "tsx scripts/test-build.ts",
    "test:db-init": "tsx --experimental-sqlite --no-warnings scripts/test-db-init.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.3.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "prettier": "^3.8.3",
    "publint": "^0.3.24",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^5.9.3",
    "vitepress": "^2.0.0-alpha.19",
    "vitest": "^4.1.7"
  }
}
