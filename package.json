{
  "name": "uesp-eso-build-wrapper",
  "version": "0.3.0",
  "description": "Node.js wrapper around the UESP ESO Build Editor math engine. Calculate Elder Scrolls Online character stats (Health, Magicka, Stamina, mitigation, crit, etc.) without rewriting any game formulas.",
  "keywords": [
    "elder-scrolls-online",
    "eso",
    "uesp",
    "build-editor",
    "character-stats",
    "eso-build",
    "game",
    "wrapper"
  ],
  "license": "MIT",
  "author": {
    "name": "Tarcisio Scotta",
    "email": "tarcisioscotta2@gmail.com",
    "url": "https://github.com/srtomy"
  },
  "homepage": "https://github.com/srtomy/uesp-eso-build-wrapper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srtomy/uesp-eso-build-wrapper.git"
  },
  "bugs": {
    "url": "https://github.com/srtomy/uesp-eso-build-wrapper/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/lib/eso-engine/index.js",
  "types": "dist/lib/eso-engine/index.d.ts",
  "type": "commonjs",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/lib/eso-engine/index.d.ts",
      "import": "./dist/lib/eso-engine/index.js",
      "require": "./dist/lib/eso-engine/index.js"
    }
  },
  "files": [
    "dist",
    "vendor/uesp-esochardata/resources/esoEditBuild.js",
    "vendor/uesp-esochardata/resources/esobuilddata.js",
    "vendor/uesp-esochardata/LICENSE",
    "vendor/uesp-esolog/resources/esoskills.js",
    "vendor/uesp-esolog/LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "publint": "publint",
    "attw": "attw --pack . --ignore-rules cjs-only-exports-default",
    "generate-data": "node --experimental-sqlite --no-warnings -r ts-node/register/transpile-only scripts/generate-data.ts",
    "prepublishOnly": "npm run build && npm run lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:explore": "ts-node --project tsconfig.json scripts/test-engine.ts",
    "test:build": "ts-node --project tsconfig.json scripts/test-build.ts",
    "test:db-init": "node --experimental-sqlite --no-warnings -r ts-node/register/transpile-only scripts/test-db-init.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.3.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "publint": "^0.3.24",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
